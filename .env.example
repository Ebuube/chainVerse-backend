EMAIL_USER=your_email@gmail.com
# Gmail “App Password” (16 chars). Do NOT use your normal Gmail password.
EMAIL_PASS='xxxx xxxx xxxx xxxx'

PORT=3002
MONGO_URI=mongodb://localhost:27017/chainVerse


# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GUEST_WINDOW_MS=60000
RATE_LIMIT_GUEST_MAX=30
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_PREMIUM_WINDOW_MS=60000
RATE_LIMIT_PREMIUM_MAX=200
RATE_LIMIT_ADMIN_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX=500
RATE_LIMIT_SKIP_SUCCESS=false
RATE_LIMIT_SKIP_FAILED=false
RATE_LIMIT_KEY_PREFIX=rl:

# Redis Configuration (optional - will use in-memory for development)
REDIS_URL='redis://localhost:6379'
FORCE_REDIS=true

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
CALLBACK_URL=http://localhost:3002/auth/google/callback
